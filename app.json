{
  "expo": {
    "name": "Chef Domingos",
    "slug": "chef",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "chefdomingos",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F5F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.chefdomingos.loyalty",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "A app Chef Domingos precisa da câmara para ler o QR dos vouchers dos clientes."
      }
    },
    "android": {
      "package": "pt.chefdomingos.loyalty",
      "adaptiveIcon": {
        "backgroundColor": "#F8F5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "A app Chef Domingos precisa da câmara para ler o QR dos vouchers dos clientes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3735c0c2-fc00-46b7-9e60-a9a584a6effb"
      }
    },
    "owner": "witflow"
  }
}
